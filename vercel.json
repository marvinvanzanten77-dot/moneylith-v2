{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "moneylith.nl" }],
      "destination": "https://www.moneylith.nl/:path*",
      "permanent": true
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com https://vercel.live; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src *; frame-src 'self' https://challenges.cloudflare.com https://vercel.live"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(privacy|disclaimer|terms|cookies|status)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!manifest\\.webmanifest|sw\\.js|offline\\.html|icons|api|_next|assets|static|logo|robots\\.txt|sitemap\\.xml|@vite|@react-refresh|@id|@fs|src|node_modules).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [{ "path": "/api/monitoring-cron", "schedule": "*/15 * * * *" }]
}
