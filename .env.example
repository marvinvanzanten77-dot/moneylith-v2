# Server-only. Kopieer lokale configuratie naar .env (buiten Git).
# Gebruik nooit VITE_-variabelen voor sleutels of testtoegang.
LUNCHFLOW_API_KEY=

# Optionele persoonlijke live-proef; uitsluitend als complete serverconfiguratie.
# Code is een willekeurige 256-bit testcode, geen zelfgekozen wachtwoord.
# Alleen de SHA-256-hash van die code gaat naar de server.
LUNCHFLOW_PRIVATE_ENABLED=false
LUNCHFLOW_OWNER_EMAIL=
LUNCHFLOW_OWNER_CODE_HASH=
LUNCHFLOW_SESSION_SECRET=
# Owner account storage (server only; separate random 32-byte hex secrets).
# Never use a VITE_ prefix. Provision a dedicated production Redis store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
CLOUD_AUTH_SECRET=
CLOUD_ENCRYPTION_KEY=

# Server-only Web Push VAPID keys (generate once; never rotate casually).
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Protects the production-only monitoring cron; at least 32 random characters.
CRON_SECRET=

# bunq: server-only personal API key. Local file: .env.bunq.local (gitignored).
# Production: BUNQ_API_KEY in Vercel secrets; never VITE_BUNQ_API_KEY.
# Installation/signing/session credentials are generated automatically.
BUNQ_API_KEY=
